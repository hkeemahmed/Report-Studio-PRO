FROM python:3.12-slim
WORKDIR /srv
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt "psycopg[binary]>=3.1" boto3
COPY backend /srv/backend
COPY packages/template-engine/templates.json /srv/packages/template-engine/templates.json
WORKDIR /srv/backend
EXPOSE 8000
CMD ["sh", "-c", "python -m app.migrate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers"]
