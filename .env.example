# ---- Backend (never commit real values) ----
RSP_JWT_SECRET=change-me-to-64-random-hex-chars
RSP_SECRETS_KEY=change-me-separate-key-for-encrypting-ai-api-keys
RSP_DATABASE_URL=sqlite:///./storage/reportstudio.db
# RSP_DATABASE_URL=postgresql+psycopg://rsp:password@localhost/rsp
RSP_STORAGE_DIR=./storage
RSP_STORAGE_BACKEND=local          # or s3
# RSP_S3_BUCKET= / RSP_S3_ENDPOINT= / RSP_S3_ACCESS_KEY= / RSP_S3_SECRET_KEY=
RSP_CORS_ORIGINS=http://localhost:5173,tauri://localhost
RSP_ACCESS_TOKEN_MINUTES=15
RSP_REFRESH_TOKEN_DAYS=30
RSP_RATE_LIMIT_PER_MINUTE=120
RSP_AI_RATE_LIMIT_PER_MINUTE=20
RSP_MAX_UPLOAD_MB=25
POSTGRES_PASSWORD=change-me
# AI provider keys are NOT configured here: add them in the app (Settings → AI providers); stored AES-GCM encrypted server-side.
